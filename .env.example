# --- MySQL (used by docker compose) ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=taskmanager
MYSQL_USER=taskuser
MYSQL_PASSWORD=change_me_user
MYSQL_PORT=3306

# Local demo defaults. Replace secrets before exposing the app publicly.
WEB_PORT=8080
WEB_BIND_ADDRESS=127.0.0.1
PUBLIC_ORIGIN=http://localhost:8080
SESSION_SECRET=local-development-secret-change-me-at-least-32-characters
COOKIE_SECURE=false
SEED_DEMO=true
